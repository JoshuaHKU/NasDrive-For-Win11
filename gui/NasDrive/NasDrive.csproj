<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Implicit usings would pull in both System.Windows and System.Windows.Forms -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NasDrive</RootNamespace>
    <AssemblyName>NasDrive</AssemblyName>
    <ApplicationIcon>Assets\NasDrive.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>NasDrive</Product>
    <Description>Map WebDAV NAS folders to Windows drive letters</Description>
    <Copyright>NasDrive contributors</Copyright>
    <!-- Allows building on macOS/Linux CI; the app itself only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\NasDrive.ico" />
    <Resource Include="Assets\tray-on.ico" />
    <Resource Include="Assets\tray-off.ico" />
    <Resource Include="Assets\tray-warn.ico" />
  </ItemGroup>

</Project>
