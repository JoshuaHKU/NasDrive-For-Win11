<Window x:Class="NasDrive.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:NasDrive.Views"
        xmlns:vm="clr-namespace:NasDrive.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="NasDrive" Width="680" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        Icon="pack://application:,,,/Assets/NasDrive.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{StaticResource AccentBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                <Border Width="40" Height="40" Background="#2E8B57">
                    <TextBlock Text="&#xE8CE;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NasDrive" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding VersionText}" FontSize="9" Foreground="#CCFFFFFF" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleButton}" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,5,0" />
                        <TextBlock Text="{v:T Main.Add}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="2,12" Background="#55FFFFFF" />
                <Button Style="{StaticResource TitleButton}" Command="{Binding SettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,5,0" />
                        <TextBlock Text="{v:T Main.Settings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="2,12" Background="#55FFFFFF" />
                <Button Style="{StaticResource TitleButton}" Click="Minimize_Click" Padding="14,0">
                    <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="10" />
                </Button>
                <Button Style="{StaticResource TitleButton}" Click="Close_Click" Padding="14,0">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Drive list -->
        <Grid Grid.Row="1" Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriveItemViewModel}">
                            <Border x:Name="row" Background="{StaticResource RowBrush}" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1"
                                    Padding="10,8" MouseLeftButtonDown="Row_MouseDown" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Title}" IsEnabled="False" />
                                        <Separator />
                                        <MenuItem Header="{v:T Tray.OpenDrive}" Command="{Binding OpenCommand}" />
                                        <MenuItem Header="{v:T Tray.Refresh}" Command="{Binding RefreshCommand}" />
                                        <MenuItem Header="{v:T Tray.Edit}" Command="{Binding EditCommand}" />
                                        <MenuItem Header="{v:T Main.Delete}" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Opacity="{Binding IsDimmed, Converter={StaticResource DimWhenTrue}}">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" />
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource WarningBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                                   Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center"
                                                Opacity="{Binding IsDimmed, Converter={StaticResource DimWhenTrue}}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border BorderBrush="{StaticResource DimTextBrush}" BorderThickness="1" Padding="3,0" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding LetterText}" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Account}" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,3,0,3" Height="14" ToolTip="{Binding PathText}">
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" BorderThickness="0"
                                                         Background="{StaticResource QuotaTrackBrush}" Foreground="{StaticResource QuotaFillBrush}" />
                                            <TextBlock Text="{Binding PathText}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                       VerticalAlignment="Center" Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SpaceText}" Style="{StaticResource Dim}" />
                                                <TextBlock Text=" · " Style="{StaticResource Dim}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="11" Margin="4,0" Foreground="{StaticResource WarningBrush}"
                                                           ToolTip="{Binding StatusText}" Visibility="{Binding HasUploads, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="4,0"
                                                           ToolTip="{v:T Badge.ReadOnly}" Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE12B;" Style="{StaticResource Icon}" FontSize="11" Margin="4,0"
                                                           ToolTip="{v:T Badge.Proxy}" Visibility="{Binding UsesProxy, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="11" Margin="4,0" ToolTip="{Binding ModeTip}" />
                                                <TextBlock x:Name="sec" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="11" Margin="4,0" ToolTip="{Binding SecurityTip}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" FontSize="11" TextWrapping="Wrap"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid>
                                            <Button x:Name="toggle" Style="{StaticResource RoundButton}" Command="{Binding ToggleCommand}" ToolTip="{v:T Main.Connect}">
                                                <TextBlock x:Name="toggleGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                            </Button>
                                            <Path Style="{StaticResource Spinner}" Width="38" Height="38" Margin="4,0" IsHitTestVisible="False"
                                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <Button Style="{StaticResource RoundButton}" Command="{Binding EditCommand}" ToolTip="{v:T Main.Edit}" Content="&#xE713;" />
                                        <Button Style="{StaticResource RoundButton}" Command="{Binding OpenCommand}" ToolTip="{v:T Main.OpenFolder}" Content="&#xE838;" />
                                        <Button Style="{StaticResource RoundButton}" Command="{Binding DeleteCommand}" ToolTip="{v:T Main.Delete}" Content="&#xE74D;" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter TargetName="toggleGlyph" Property="Text" Value="&#xE71A;" />
                                    <Setter TargetName="toggle" Property="ToolTip" Value="{v:T Main.Disconnect}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Insecure}" Value="True">
                                    <Setter TargetName="sec" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE8CE;" Style="{StaticResource Icon}" FontSize="56" HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}" />
                <TextBlock Text="{v:T Main.Empty}" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{v:T Main.EmptyHint}" Style="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Height="34" HorizontalAlignment="Center"
                        Command="{Binding AddCommand}" Content="{v:T Main.AddFirst}" />
            </StackPanel>
        </Grid>

        <!-- Editor and settings pages -->
        <v:DriveEditorView Grid.Row="1" DataContext="{Binding Editor}"
                           Visibility="{Binding DataContext.IsEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        <v:SettingsView Grid.Row="1" DataContext="{Binding SettingsVm}"
                        Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
