<Window x:Class="NasDrive.Views.HostKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:NasDrive.Views"
        Title="{v:T HostKey.Title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        Icon="pack://application:,,,/Assets/NasDrive.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{v:T HostKey.Server}" Style="{StaticResource Dim}" Margin="0,0,12,4" />
                <TextBlock x:Name="ServerText" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Text="{v:T HostKey.Type}" Style="{StaticResource Dim}" Margin="0,0,12,4" />
                <TextBlock x:Name="TypeText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Text="{v:T HostKey.Fingerprint}" Style="{StaticResource Dim}" Margin="0,0,12,0" />
                <TextBox x:Name="FingerprintText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <TextBlock x:Name="Hint" Style="{StaticResource Dim}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TrustButton" Style="{StaticResource PrimaryButton}" Click="Trust_Click" />
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="{v:T Editor.Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
