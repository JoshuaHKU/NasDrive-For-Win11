<Window x:Class="NasDrive.Views.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:NasDrive.Views"
        Title="{v:T Prompt.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        Icon="pack://application:,,,/Assets/NasDrive.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="{v:T Editor.User}" Margin="0,0,0,4" />
        <TextBox x:Name="UserBox" Margin="0,0,0,10" />
        <TextBlock Text="{v:T Editor.Pass}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PassBox" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource PrimaryButton}" Content="{v:T Prompt.Ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{v:T Editor.Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
