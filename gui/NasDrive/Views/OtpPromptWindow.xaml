<Window x:Class="NasDrive.Views.OtpPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:NasDrive.Views"
        Title="{v:T Otp.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        Icon="pack://application:,,,/Assets/NasDrive.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{v:T Otp.Body}" TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,0,0,12" />
        <TextBox x:Name="CodeBox" FontSize="20" FontFamily="Consolas" MaxLength="8" HorizontalContentAlignment="Center" Margin="0,0,0,8" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{v:T Prompt.Ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{v:T Editor.Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
