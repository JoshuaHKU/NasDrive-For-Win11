<UserControl x:Class="NasDrive.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:NasDrive.Views"
             xmlns:vm="clr-namespace:NasDrive.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="{StaticResource WindowBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource RoundButton}" Command="{Binding BackCommand}" ToolTip="{v:T Main.Back}" Content="&#xE72B;" Margin="0,0,14,0" />
                <TextBlock Text="{v:T Settings.Title}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- General -->
            <TextBlock Grid.Row="1" Text="{v:T Settings.General}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,2,10,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                <CheckBox IsChecked="{Binding StartWithWindows}" Content="{v:T Settings.StartWithWindows}" />
                <CheckBox IsChecked="{Binding OpenExplorerAfterConnect}" Content="{v:T Settings.OpenExplorer}" />
                <CheckBox IsChecked="{Binding AllowCustomDriveIcons}" Content="{v:T Settings.CustomIcons}" />
            </StackPanel>

            <!-- Language -->
            <TextBlock Grid.Row="2" Text="{v:T Settings.Language}" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,14"
                      ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" />

            <!-- Cache -->
            <TextBlock Grid.Row="3" Text="{v:T Settings.Cache}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,5,10,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CacheDir}" />
                    <Button Grid.Column="1" Style="{StaticResource DialogButton}" MinWidth="0" Margin="6,0,0,0" Command="{Binding BrowseCacheCommand}" ToolTip="{v:T Settings.Browse}">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource DialogButton}" Margin="6,0,0,0" Command="{Binding DefaultCacheCommand}" Content="{v:T Settings.Default}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{v:T Settings.ReadDuration}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="80" ItemsSource="{Binding ReadDurations}" SelectedItem="{Binding ReadCacheDuration}" />
                    <TextBlock Text="{v:T Settings.WriteDelay}" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <ComboBox Width="70" ItemsSource="{Binding WriteDelays}" SelectedItem="{Binding WriteBackDelay}" />
                    <Button Style="{StaticResource DialogButton}" Margin="10,0,0,0" Command="{Binding DefaultDurationsCommand}" Content="{v:T Settings.Default}" />
                    <Button Style="{StaticResource DialogButton}" Margin="0" Command="{Binding ClearCacheCommand}" Content="{v:T Settings.ClearCache}" />
                </StackPanel>
            </StackPanel>

            <!-- Updates -->
            <TextBlock Grid.Row="4" Text="{v:T Settings.Update}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource DialogButton}" Command="{Binding CheckUpdateCommand}" Content="{v:T Settings.Check}" />
                <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" Margin="4,0,14,0" />
                <CheckBox IsChecked="{Binding AutoCheckUpdates}" Content="{v:T Settings.AutoCheck}" />
            </StackPanel>

            <!-- Proxy -->
            <TextBlock Grid.Row="5" Text="{v:T Settings.Proxy}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,5,10,0" />
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding ProxyTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ProxyType}" />
                    <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding ProxyHost}" IsEnabled="{Binding ProxyEnabled}" ToolTip="host.example.com" />
                    <TextBlock Grid.Column="2" Text=":" Margin="4,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="{Binding ProxyPort}" IsEnabled="{Binding ProxyEnabled}" />
                    <Button Grid.Column="4" Style="{StaticResource DialogButton}" Margin="6,0,0,0" Command="{Binding DefaultProxyCommand}" Content="{v:T Settings.Default}" />
                </Grid>
                <Grid Margin="0,6,0,0" IsEnabled="{Binding ProxyEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ProxyUser}" ToolTip="{v:T Editor.User}" />
                    <PasswordBox Grid.Column="2" x:Name="ProxyPass" PasswordChanged="ProxyPass_PasswordChanged" ToolTip="{v:T Editor.Pass}" />
                </Grid>
                <TextBlock Text="{v:T Settings.ProxyHint}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Advanced -->
            <TextBlock Grid.Row="6" Text="{v:T Settings.Advanced}" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{v:T Settings.LogLevel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="100" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />
                <Button Style="{StaticResource DialogButton}" Margin="10,0,0,0" Command="{Binding OpenLogsCommand}" Content="{v:T Settings.OpenLogs}" />
            </StackPanel>

            <!-- About -->
            <TextBlock Grid.Row="7" Text="{v:T Settings.About}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,14">
                <TextBlock Text="{Binding VersionText}" />
                <TextBlock Text="{Binding EngineInfo}" Style="{StaticResource Dim}" />
                <TextBlock Text="{v:T Settings.AboutText}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Content="{v:T Settings.Apply}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
